
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Pin all app tables to a dedicated schema so we never touch the unrelated
  // data living in this database's `public` schema. multiSchema qualifies every
  // table with `proof_of_impact`, so this holds regardless of any ?schema= param
  // on DATABASE_URL.
  schemas  = ["proof_of_impact"]
}

model Founder {
  id           String        @id @default(uuid())
  workshopName String
  region       String
  passwordHash String
  createdAt    DateTime      @default(now())
  certificates Certificate[]

  @@schema("proof_of_impact")
}

model Certificate {
  id             String      @id // = EAS attestation UID, set explicitly at creation — never DB-generated
  founderId      String
  founder        Founder     @relation(fields: [founderId], references: [id])
  sdgIndicator   String
  milestoneDate  DateTime
  coverageAmount Int?
  mediaHash      String?
  txHash         String
  chainNetwork   String      @default("sepolia")
  createdAt      DateTime    @default(now())
  storyMedia     StoryMedia?

  // SCOPE-EXTEND (follow-up spec): blurred workshop image. The image itself
  // lives off-chain on Cloudinary (certificateImageUrl); only imageHash is
  // mirrored on-chain alongside mediaHash. Both nullable — image is optional.
  certificateImageUrl String? // Cloudinary secure_url, blurred version only
  imageHash           String? // hash of the blurred image bytes, mirrored on-chain

  @@schema("proof_of_impact")
}

model StoryMedia {
  id                String      @id @default(uuid())
  certificateId     String      @unique
  certificate       Certificate @relation(fields: [certificateId], references: [id])
  voiceUrl          String
  clipUrl           String
  milestoneText     String
  generatedClipUrl  String?
  generatedPageSlug String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  people            Person[]

  @@schema("proof_of_impact")
}

model Person {
  id            String     @id @default(uuid())
  storyMediaId  String
  storyMedia    StoryMedia @relation(fields: [storyMediaId], references: [id], onDelete: Cascade)
  name          String
  role          String?
  // No default value on purpose. consentPublic must be explicitly set
  // on every insert — enforced again at the application layer in
  // story.schema.ts and story.service.ts. See consent enforcement notes there.
  consentPublic Boolean
  updatedAt     DateTime   @updatedAt

  @@schema("proof_of_impact")
}
